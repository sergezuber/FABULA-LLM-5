# ── Secrets / keys (never commit) ─────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*secret*
*credentials*

# ── OS / editor ───────────────────────────────────────────────
.DS_Store
*.swp

# ── Local tool state (regenerable) ────────────────────────────
.fabula/
.serena/
# …except the demo's published Proof-of-Done receipts (committed evidence, replayed verbatim)
!demo/.fabula/
demo/.fabula/*
!demo/.fabula/receipts/

# ── Dependencies (regenerable) ────────────────────────────────
node_modules/
**/node_modules/
.venv/
venv/
__pycache__/
*.pyc

# ── Build artifacts ───────────────────────────────────────────
*.app/
.build/
**/.build/
DerivedData/
dist/
build/

# ── Runtime logs / databases ──────────────────────────────────
# `*.log` alone misses a rotated log, because the suffix lands AFTER the extension:
# `adapter.err.log.old` and `adapter.err.log.pre25` slipped past it and were tracked for
# 194 commits, carrying the machine owner's real home directory into a public repository.
*.log
*.log.*
*.db
*.sqlite

# ── Personal working config (start from the *.example templates) ──
/fabula.config.json
/fabula.config.jsonc

# ── Vendored engine build artifacts (regenerable) ─────────────
engine/**/dist/
engine/**/node_modules/
# Repo-local installed engine binary + any build backups (108MB each, regenerated by build.sh; the app runs this)
/bin/
engine/**/*.gen.ts
# EXCEPTION: commit the SDK's generated client. The frontend build imports it, but it is produced by a
# codegen step (bun dev generate + @hey-api/openapi-ts) that build.sh does NOT run before the frontend
# build — so a fresh clone without these files fails to build. Committing them makes `./setup.sh` build
# from a clean checkout with no codegen toolchain. Regenerate on engine-API changes: bun run build (in engine/packages/sdk/js).
!engine/packages/sdk/js/src/gen/**/*.gen.ts
!engine/packages/sdk/js/src/v2/gen/**/*.gen.ts
engine/.turbo/
engine/**/.turbo/

# ── Contributor guide kept local (not published) ──
/CLAUDE.md

# ── Private benchmark harness + results (NEVER commit — internal only) ──
private-bench/

# ── Private launch / marketing notes (internal only, never published) ──
/docs/LAUNCH-PLAYBOOK.md

# Rust build artifacts of the cross-platform shell (hundreds of MB, reproducible from source)
shell/target/
shell/gen/

# A platform simulation that also moves HOME makes tools write real files under names built with the
# OTHER system's separator. On a POSIX filesystem those are not directories but single files whose
# names contain backslashes, and such a path makes the repository impossible to check out on Windows
# at all — git refuses the whole tree. The gate in plugin/__tests__ is the guarantee; this only keeps
# the working copy quiet.
plugin/C:*
*\\*
