{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FABULA",
  "version": "0.232.0",
  "identifier": "com.sistemma.fabula-llm-5",
    "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
